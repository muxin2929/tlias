<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hgh.mapper.EmpExprMapper" >
    <!--批量保存经历记录-->
    <insert id="insertBatch">
        insert into emp_expr (emp_id, begin,end,company,job) values
        <foreach collection="exprList" item="item" separator=",">
            (#{item.empId},#{item.begin},#{item.end},#{item.company},#{item.job})
        </foreach>
    </insert>
    <delete id="deleteBatch">
        delete from emp_expr where emp_id in
        <foreach collection="empIds" item="empId" open="(" close=")" separator=",">
            #{empId}
        </foreach>
    </delete>

</mapper>